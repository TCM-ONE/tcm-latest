# The Code Munk - root routing
# Web root = project root. Original static pages + assets are served directly;
# dynamic app routes (/auth, /admin, /student, /api, /enquiry, /portfolio) go to app.php.

DirectoryIndex index.html

# Disable directory listings
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Canonical production host. Localhost/XAMPP development is unaffected.
    RewriteCond %{HTTP_HOST} ^www\.thecodemunk\.in$ [NC]
    RewriteRule ^ https://thecodemunk.in%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{HTTP_HOST} ^thecodemunk\.in$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://thecodemunk.in%{REQUEST_URI} [R=301,L,NE]

    # Dynamic sitemap keeps published course/workshop URLs in sync.
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # Legacy course detail URLs now point to clean, server-rendered canonicals.
    RewriteCond %{QUERY_STRING} (^|&)course=full-stack-development(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/full-stack-web-development? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=frontend-development(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/frontend-development-with-react? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=python-development(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/python-programming-automation? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=python-automation(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/python-programming-automation? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=database-systems(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/sql-database-fundamentals? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=dsa-problem-solving(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/dsa-problem-solving-java? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=cloud-fundamentals(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/aws-cloud-deployment-fundamentals? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=cloud-devops(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/docker-devops-cicd-essentials? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=computer-basics(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/digital-skills-computer-fundamentals? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=web-development-basics(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/build-your-first-website? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=ai-tools-mastery(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/ai-tools-for-study-work? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=ai-automation(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/ai-automation-nocode-tools? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=data-analytics(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/data-analytics-excel-sql-powerbi? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=data-science-ai(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/data-science-machine-learning-foundations? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=career-transition-program(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/tech-career-launchpad? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=career-coaching(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/tech-career-launchpad? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=system-design(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/system-design-microservices-foundations? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=react-nextjs(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/react-nextjs-frontend-engineering? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=backend-systems(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/backend-development-nodejs-apis? [R=301,L,NE]
    RewriteCond %{QUERY_STRING} (^|&)course=mobile-app-dev(&|$) [NC]
    RewriteRule ^course-details\.html$ courses/mobile-app-development-react-native? [R=301,L,NE]
    RewriteRule ^courses/dsa-with-java$ courses/dsa-problem-solving-java [R=301,L,NE]

    # Block direct access to application internals and secrets
    RewriteRule ^(src|config|database|storage|views|bin|docs|artifacts)(/|$) - [F,L]
    RewriteRule (^|/)\.(env|git) - [F,L]

    # ------------------------------------------------------------------
    # Canonical 301 URL Consolidation
    # Redirect legacy .html URLs and /index.html to clean canonical routes
    # ------------------------------------------------------------------
    # Canonical homepage redirect: /index.html -> /
    RewriteCond %{THE_REQUEST} \s/+(?:tcm/)?index\.html[\s?] [NC]
    RewriteRule ^index\.html$ ./ [R=301,L]

    # Clean extensionless route consolidation
    RewriteRule ^courses\.html$ courses [R=301,L]
    RewriteRule ^workshops\.html$ workshops [R=301,L]
    RewriteRule ^about\.html$ about [R=301,L]
    RewriteRule ^contact\.html$ contact [R=301,L]
    RewriteRule ^partner\.html$ for-institutions [R=301,L]
    RewriteRule ^partner$ for-institutions [R=301,L]
    RewriteRule ^for-institutions\.html$ for-institutions [R=301,L]
    RewriteRule ^insights\.html$ tech-updates [R=301,L]
    RewriteRule ^insights$ tech-updates [R=301,L]
    RewriteRule ^programs\.html$ courses [R=301,L]
    RewriteRule ^programs$ courses [R=301,L]

    # Serve real files and directories (HTML, CSS, JS, uploads) as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route everything else through the front controller
    RewriteRule ^ app.php [L]
</IfModule>

# Belt-and-braces: deny dotfiles
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Never expose one-time installers, diagnostics or migration utilities if they
# are uploaded manually outside the controlled release pipeline.
<FilesMatch "^(setup|prod-debug|quick-debug|test.*|check.*|fix.*|migrate.*|generate-content|generate_icons|setup-ai-content|verify_fixes)\.php$">
    Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# Security & SEO Trust Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ----------------------------------------------------------------------
# Speed Optimization: Gzip / Deflate Compression
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Speed Optimization: Browser Caching (Expires Headers)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
