# ================================================================
# The Code Munk — Environment Configuration
# ================================================================
# HOW TO USE ON HOSTINGER (thecodemunk.in):
#
#   1. Open Hostinger hPanel → File Manager → public_html
#   2. Find the ".env" file (or create it)
#   3. Replace its contents with this template
#   4. Fill in your real DB credentials (from hPanel → Databases)
#   5. Save the file
#
# LOCAL XAMPP: Keep APP_BASE_PATH=/tcm/tcm-2.0 and DB creds as root
# ================================================================

APP_NAME="The Code Munk"
APP_ENV=production
APP_DEBUG=false

# ── BASE PATH ────────────────────────────────────────────────────
# PRODUCTION (thecodemunk.in — files in public_html root): leave EMPTY
# LOCAL XAMPP (subfolder):  APP_BASE_PATH=/tcm/tcm-2.0
APP_BASE_PATH=

APP_URL=https://thecodemunk.in
APP_TIMEZONE=Asia/Kolkata
APP_KEY=change-me-use-64-random-characters

# ── Database ─────────────────────────────────────────────────────
# Hostinger: hPanel → Databases → MySQL Databases
# Username/DB name format:  u123456789_tcm
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=YOUR_DB_NAME
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
DB_CHARSET=utf8mb4

# ── Session ──────────────────────────────────────────────────────
SESSION_NAME=tcm_session
SESSION_LIFETIME=7200

# ── Uploads ──────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880

# ── Email (Gmail SMTP) ───────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=thecodemunk@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=thecodemunk@gmail.com
MAIL_FROM_NAME="The Code Munk"
MAIL_ADMIN=thecodemunk@gmail.com

# ── OpenRouter AI (TCM Agent + Lesson Content Generation) ────────
# Get your key at: https://openrouter.ai/keys
# Used for BOTH TCM Agent chat AND auto-generating lesson content
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Note: OpenRouter provides access to multiple AI models (GPT-4, Claude, etc.)
# No need for separate Gemini or OpenAI keys!
# IMPORTANT: In Google Cloud Console → APIs → Credentials → Your OAuth client
# Add this to "Authorized redirect URIs":
#   https://thecodemunk.in/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=https://thecodemunk.in/auth/google/callback

# ── PayU Payment Gateway (India) ─────────────────────────────────
PAYU_MODE=production
PAYU_KEY=your-payu-merchant-key
PAYU_SALT=your-payu-salt
PAYU_CLIENT_ID=your-payu-client-id
PAYU_CLIENT_SECRET=your-payu-client-secret


# International markup in whole percent (35–55). USD course pricing uses a flat 30%.
# Settlement remains in INR.
PRICING_INTERNATIONAL_MARKUP=45
# Optional JSON map keyed by the existing course category IDs, e.g. {"4":35,"7":55}.
PRICING_CATEGORY_MARKUPS={}
# Optional USD estimates ending in 9, within 2% of the exact conversion and the markup bounds.
PRICING_ROUND_USD_ESTIMATES=0
# Trusted country detection applies international checkout restrictions.
# Unknown countries fall back to the standard INR checkout.
# Enable only after restricting the origin to a trusted Cloudflare proxy.
PRICING_TRUST_CF_COUNTRY=0

# International bank transfer details. Confirm SWIFT routing with the bank.
INTL_BANK_HOLDER=
INTL_BANK_NAME=
INTL_BANK_ACCOUNT=
INTL_BANK_IFSC=
INTL_BANK_ADDRESS=
INTL_BANK_SWIFT=
